# ==========================================
# REAL NURSE - ENVIRONMENT VARIABLES CONFIG
# ==========================================

# 1. Google Gemini AI (Required for Question Generation, Summarization & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (Required for Auth, PostgreSQL, Storage & Vector search)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 3. Backend API Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 4. Optional Storage & Rate Limit Settings
MAX_FILE_UPLOAD_MB=50
RATE_LIMIT_RPM=60
